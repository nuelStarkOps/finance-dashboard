# Personal Finance OS — local development environment variables.
# Copy to `.env` (git-ignored) and adjust values for local development.
# Never commit real credentials or production secrets.

# ---- PostgreSQL (docker-compose service `db`) ----
POSTGRES_USER=pfos
POSTGRES_PASSWORD=pfos_dev_password
POSTGRES_DB=pfos
POSTGRES_PORT=5432

# ---- Backend ----
# Used inside Docker Compose (hostname `db`). For host-based development
# against the Compose Postgres, use `localhost` instead of `db`.
DATABASE_URL=postgresql+psycopg://pfos:pfos_dev_password@db:5432/pfos
BACKEND_PORT=8000

# ---- Frontend ----
FRONTEND_PORT=3000

# ---- Auth ----
# `dev` runs the built-in local identity provider (no external service).
# Switch to `cognito` once a user pool is provisioned.
AUTH_PROVIDER=dev
DEV_AUTH_ENABLED=true
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_REGION=eu-west-1
COGNITO_ISSUER=
COGNITO_JWKS_URL=
