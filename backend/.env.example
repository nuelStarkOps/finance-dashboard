# Personal Finance OS — backend environment variables.
# Copy to `.env` (git-ignored) for local, non-Docker development.

# PostgreSQL connection (host variant: use `localhost` when running on the host).
DATABASE_URL=postgresql+psycopg://pfos:pfos_dev_password@localhost:5432/pfos

# Application
ENVIRONMENT=development
APP_NAME=Personal Finance OS API

# Auth (Phase 1; placeholders)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_REGION=eu-west-1
